NODE_ENV=development
PORT=8081
# Set these to a LAN IP or public hostname (not localhost) if this needs to
# be reachable from another device — localhost only resolves to whichever
# machine is making the request.
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3002
# Extra allowed CORS origins, comma-separated (optional).
CORS_ORIGINS=

DATABASE_URL="mysql://root:PASSWORD@localhost:3306/nestsms_url_shortener"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=nestsms_url_shortener
DB_CONNECTION_LIMIT=20
# Enable for any DB reached over the public internet (e.g. a hosted provider's
# public proxy endpoint). Leave false for local/Docker MySQL.
DATABASE_SSL=false
# Only set to false if your provider's cert isn't verifiable and you hit a
# connection error — this trades away MITM protection, so it's opt-in.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

LOG_LEVEL=debug
CONSOLE_LOGS=true

SHORT_URL_CODE_LENGTH=7
